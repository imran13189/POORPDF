<div class="card p-4">
    <h1 class="mb-4">Create PDF from HTML Online</h1>
    <p>
        Paste your HTML code below, preview it instantly, and download as a PDF.
        This free tool helps developers, bloggers, and designers convert HTML into PDF files.
    </p>

    <form id="html-form">
        <div class="form-group">
            <label for="html-input">Paste your HTML code here:</label>
            <textarea class="form-control" id="html-input" rows="10"
                      placeholder="&lt;h1&gt;Hello PDFOcean!&lt;/h1&gt;"></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-lg btn-block">
            Generate PDF
        </button>
    </form>

    <!-- SEO-friendly live preview -->
    <h2 class="mt-4">Live Preview</h2>
    <div id="html-preview" class="p-3 border bg-light">
        <em>Your HTML output will appear here...</em>
    </div>
</div>

