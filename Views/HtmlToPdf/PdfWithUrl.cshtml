
<div class="card p-4">
    <h1 class="mb-4">Create PDF from URL</h1>
    <form id="url-form">
        <div class="form-group">
            <label for="url-input">Enter the URL of the webpage:</label>
            <input type="url" class="form-control form-control-lg" id="url-input" placeholder="https://www.example.com" required>
        </div>
        <button type="submit" class="btn btn-primary btn-lg btn-block">Generate PDF</button>
    </form>
</div>


